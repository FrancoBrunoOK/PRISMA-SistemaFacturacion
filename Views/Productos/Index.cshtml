@model IEnumerable<SistemaFacturacion.Models.Producto>

@{
    ViewData["Title"] = "Productos";
}

<!-- ENCABEZADO -->
<div class="page-header mb-4">

    <div>
        <h1 class="mb-1">
            Productos
        </h1>

        <p class="text-muted mb-0">
            Administración del catálogo de productos
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-primary">

        + Nuevo Producto

    </a>

</div>


<!-- FILTROS -->
<div class="card mb-4">

    <div class="card-body">

        <form asp-action="Index"
              method="get">

            <div class="row g-3 align-items-end">

                <!-- ESTADO -->
                <div class="col-md-3">

                    <label class="form-label">
                        Estado
                    </label>

                    <select name="filtroEstado"
                            class="form-select">

                        @if (ViewBag.FiltroEstado == "Activos")
                        {
                            <option value="Activos" selected>
                                Activos
                            </option>
                        }
                        else
                        {
                            <option value="Activos">
                                Activos
                            </option>
                        }

                        @if (ViewBag.FiltroEstado == "Inactivos")
                        {
                            <option value="Inactivos" selected>
                                Inactivos
                            </option>
                        }
                        else
                        {
                            <option value="Inactivos">
                                Inactivos
                            </option>
                        }

                        @if (ViewBag.FiltroEstado == "Todos")
                        {
                            <option value="Todos" selected>
                                Todos
                            </option>
                        }
                        else
                        {
                            <option value="Todos">
                                Todos
                            </option>
                        }

                    </select>

                </div>


                <!-- BUSCADOR -->
                <div class="col-md-5">

                    <label class="form-label">
                        Buscar producto
                    </label>

                    <input type="text"
                           name="buscar"
                           value="@ViewBag.Buscar"
                           class="form-control"
                           placeholder="Código o descripción..." />

                </div>


                <!-- BOTONES -->
                <div class="col-md-4">

                    <button type="submit"
                            class="btn btn-primary me-2">

                        Buscar

                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">

                        Limpiar

                    </a>

                </div>

            </div>

        </form>

    </div>

</div>


<!-- TABLA DE PRODUCTOS -->
<div class="card">

    <div class="card-body p-0">

        <div class="table-responsive">

            <table class="table table-hover mb-0">

                <thead>

                    <tr>

                        <th class="ps-4">
                            Código
                        </th>

                        <th>
                            Descripción
                        </th>

                        <th class="text-end">
                            Precio
                        </th>

                        <th class="text-end">
                            IVA
                        </th>

                        <th>
                            Estado
                        </th>

                        <th class="text-end pe-4">
                            Acciones
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>

                                <!-- CÓDIGO -->
                                <td class="ps-4">

                                    <strong>
                                        @item.Codigo
                                    </strong>

                                </td>


                                <!-- DESCRIPCIÓN -->
                                <td>
                                    @item.Descripcion
                                </td>


                                <!-- PRECIO -->
                                <td class="text-end">

                                    @item.Precio.ToString("C2")

                                </td>


                                <!-- IVA -->
                                <td class="text-end">

                                    @item.IVA.ToString("N2") %

                                </td>


                                <!-- ESTADO -->
                                <td>

                                    @if (item.Activo)
                                    {
                                        <span class="badge bg-success-subtle text-success">
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger">
                                            Inactivo
                                        </span>
                                    }

                                </td>


                                <!-- ACCIONES -->
                                <td class="text-end pe-4">

                                    <div class="d-inline-flex gap-1">

                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary">

                                            Ver

                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-secondary">

                                            Editar

                                        </a>

                                        @if (item.Activo)
                                        {
                                            <a asp-action="Delete"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-danger">

                                                Dar de baja

                                            </a>
                                        }
                                        else
                                        {
                                            <a asp-action="Activar"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-success">

                                                Dar de alta

                                            </a>
                                        }

                                    </div>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="6"
                                class="text-center py-5">

                                <div class="empty-table">

                                    <strong>
                                        No se encontraron productos
                                    </strong>

                                    <span>
                                        Probá modificando los filtros de búsqueda.
                                    </span>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>