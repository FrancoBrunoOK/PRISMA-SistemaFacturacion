@model IEnumerable<SistemaFacturacion.Models.Cliente>

@{
    ViewData["Title"] = "Clientes";
}

<!-- ENCABEZADO -->
<div class="page-header mb-4">

    <div>
        <h1 class="mb-1">
            Clientes
        </h1>

        <p class="text-muted mb-0">
            Administración de clientes del sistema
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-primary">

        + Nuevo Cliente

    </a>

</div>


<!-- FILTROS -->
<div class="card mb-4">

    <div class="card-body">

        <form asp-action="Index"
              method="get">

            <div class="row g-3 align-items-end">

                <!-- ESTADO -->
                <div class="col-md-3">

                    <label class="form-label">
                        Estado
                    </label>

                    <select name="filtroEstado"
                            class="form-select">

                        @if (ViewBag.FiltroEstado == "Activos")
                        {
                            <option value="Activos" selected>
                                Activos
                            </option>
                        }
                        else
                        {
                            <option value="Activos">
                                Activos
                            </option>
                        }

                        @if (ViewBag.FiltroEstado == "Inactivos")
                        {
                            <option value="Inactivos" selected>
                                Inactivos
                            </option>
                        }
                        else
                        {
                            <option value="Inactivos">
                                Inactivos
                            </option>
                        }

                        @if (ViewBag.FiltroEstado == "Todos")
                        {
                            <option value="Todos" selected>
                                Todos
                            </option>
                        }
                        else
                        {
                            <option value="Todos">
                                Todos
                            </option>
                        }

                    </select>

                </div>


                <!-- BUSCADOR -->
                <div class="col-md-5">

                    <label class="form-label">
                        Buscar cliente
                    </label>

                    <input type="text"
                           name="buscar"
                           value="@ViewBag.Buscar"
                           class="form-control"
                           placeholder="Nombre, CUIT, DNI, email o teléfono..." />

                </div>


                <!-- BOTONES -->
                <div class="col-md-4">

                    <button type="submit"
                            class="btn btn-primary me-2">

                        Buscar

                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">

                        Limpiar

                    </a>

                </div>

            </div>

        </form>

    </div>

</div>


<!-- TABLA DE CLIENTES -->
<div class="card">

    <div class="card-body p-0">

        <div class="table-responsive">

            <table class="table table-hover mb-0">

                <thead>

                    <tr>

                        <th class="ps-4">
                            Nombre
                        </th>

                        <th>
                            CUIT
                        </th>

                        <th>
                            DNI
                        </th>

                        <th>
                            Teléfono
                        </th>

                        <th>
                            Email
                        </th>

                        <th>
                            Estado
                        </th>

                        <th class="text-end pe-4">
                            Acciones
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model.Any())
                    {
                        @foreach (var cliente in Model)
                        {
                            <tr>

                                <!-- NOMBRE -->
                                <td class="ps-4">

                                    <strong>
                                        @cliente.Nombre
                                    </strong>

                                </td>


                                <!-- CUIT -->
                                <td>

                                    @if (!string.IsNullOrWhiteSpace(cliente.CUIT))
                                    {
                                        @cliente.CUIT
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }

                                </td>


                                <!-- DNI -->
                                <td>

                                    @if (!string.IsNullOrWhiteSpace(cliente.DNI))
                                    {
                                        @cliente.DNI
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }

                                </td>


                                <!-- TELÉFONO -->
                                <td>

                                    @if (!string.IsNullOrWhiteSpace(cliente.Telefono))
                                    {
                                        @cliente.Telefono
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }

                                </td>


                                <!-- EMAIL -->
                                <td>

                                    @if (!string.IsNullOrWhiteSpace(cliente.Email))
                                    {
                                        @cliente.Email
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            —
                                        </span>
                                    }

                                </td>


                                <!-- ESTADO -->
                                <td>

                                    @if (cliente.Activo)
                                    {
                                        <span class="badge bg-success-subtle text-success">
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger">
                                            Inactivo
                                        </span>
                                    }

                                </td>


                                <!-- ACCIONES -->
                                <td class="text-end pe-4">

                                    <div class="d-inline-flex gap-1">

                                        <a asp-action="Details"
                                           asp-route-id="@cliente.Id"
                                           class="btn btn-sm btn-outline-primary">

                                            Ver

                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@cliente.Id"
                                           class="btn btn-sm btn-outline-secondary">

                                            Editar

                                        </a>

                                        @if (cliente.Activo)
                                        {
                                            <a asp-action="Delete"
                                               asp-route-id="@cliente.Id"
                                               class="btn btn-sm btn-outline-danger">

                                                Dar de baja

                                            </a>
                                        }
                                        else
                                        {
                                            <a asp-action="Activar"
                                               asp-route-id="@cliente.Id"
                                               class="btn btn-sm btn-outline-success">

                                                Dar de alta

                                            </a>
                                        }

                                    </div>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="7"
                                class="text-center py-5">

                                <div class="empty-table">

                                    <strong>
                                        No se encontraron clientes
                                    </strong>

                                    <span>
                                        Probá modificando los filtros de búsqueda.
                                    </span>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


<!-- PAGINACIÓN -->
@{
    int paginaActual = ViewBag.PaginaActual;
    int totalPaginas = ViewBag.TotalPaginas;
    int totalRegistros = ViewBag.TotalRegistros;
    int tamanioPagina = ViewBag.TamanioPagina;

    int desde = totalRegistros == 0
        ? 0
        : ((paginaActual - 1) * tamanioPagina) + 1;

    int hasta = Math.Min(
        paginaActual * tamanioPagina,
        totalRegistros);
}

@if (totalRegistros > 0)
{
    <div class="d-flex flex-column flex-md-row
        justify-content-between align-items-center
        gap-3 mt-4">

        <!-- INFORMACIÓN -->
        <div class="text-muted small">

            Mostrando
            <strong>@desde</strong>
            -
            <strong>@hasta</strong>
            de
            <strong>@totalRegistros</strong>
            clientes

        </div>


        <!-- PAGINACIÓN -->
        @if (totalPaginas > 1)
        {
            <nav aria-label="Paginación de clientes">

                <ul class="pagination mb-0">

                    <!-- ANTERIOR -->
                    <li class="page-item
                        @(paginaActual == 1 ? "disabled" : "")">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-pagina="@(paginaActual - 1)"
                           asp-route-filtroEstado="@ViewBag.FiltroEstado"
                           asp-route-buscar="@ViewBag.Buscar">

                            Anterior

                        </a>

                    </li>


                    <!-- NÚMEROS DE PÁGINA -->
                    @for (int i = 1; i <= totalPaginas; i++)
                    {
                        <li class="page-item
                            @(i == paginaActual ? "active" : "")">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-pagina="@i"
                               asp-route-filtroEstado="@ViewBag.FiltroEstado"
                               asp-route-buscar="@ViewBag.Buscar">

                                @i

                            </a>

                        </li>
                    }


                    <!-- SIGUIENTE -->
                    <li class="page-item
                        @(paginaActual == totalPaginas
                            ? "disabled"
                            : "")">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-pagina="@(paginaActual + 1)"
                           asp-route-filtroEstado="@ViewBag.FiltroEstado"
                           asp-route-buscar="@ViewBag.Buscar">

                            Siguiente

                        </a>

                    </li>

                </ul>

            </nav>
        }

    </div>
}