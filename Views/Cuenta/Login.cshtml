
@model SistemaFacturacion.Models.LoginViewModel

@{
    ViewData["Title"] = "Iniciar sesión";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="row justify-content-center mt-5">
    <div class="col-md-7 col-lg-5">

        <div class="card border-0 shadow-lg rounded-4">

            <div class="card-body p-4 p-md-5">

                <div class="text-center mb-4">
                    <h1 class="fw-bold">PRISMA</h1>
                    <p class="text-muted">
                        Sistema de Gestión y Facturación
                    </p>
                    <h4 class="mt-4">Iniciar sesión</h4>
                </div>

                <form asp-controller="Cuenta"
                      asp-action="Login"
                      asp-route-returnUrl="@returnUrl"
                      method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="Email"
                               class="form-control form-control-lg"
                               autocomplete="username"
                               placeholder="correo@ejemplo.com" />

                        <span asp-validation-for="Email"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="Password"
                               class="form-control form-control-lg"
                               autocomplete="current-password"
                               placeholder="Ingresá tu contraseña" />

                        <span asp-validation-for="Password"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="Recordarme"
                               class="form-check-input" />

                        <label asp-for="Recordarme"
                               class="form-check-label">
                        </label>
                    </div>

                    <button type="submit"
                            class="btn btn-primary btn-lg w-100">
                        Ingresar a PRISMA
                    </button>
                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
