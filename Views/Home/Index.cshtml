@model SistemaFacturacion.Models.DashboardViewModel

@{
    ViewData["Title"] = "Inicio";
}

<!-- ENCABEZADO -->
<div class="dashboard-header mb-4">

    <div>
        <h1 class="mb-1">
            Panel de control
        </h1>

        <p class="text-muted mb-0">
            Resumen general del sistema de facturación
        </p>
    </div>

    <a asp-controller="Facturas"
       asp-action="Nueva"
       class="btn btn-success">

        + Nueva Factura

    </a>

</div>


<!-- INDICADORES PRINCIPALES -->
<div class="row g-4 mb-4">

    <!-- CLIENTES -->
    <div class="col-md-6 col-xl">

        <div class="card dashboard-card h-100">

            <div class="card-body">

                <div class="dashboard-card-label">
                    Clientes activos
                </div>

                <div class="dashboard-number">
                    @Model.ClientesActivos
                </div>

                <a asp-controller="Clientes"
                   asp-action="Index"
                   class="dashboard-link">

                    Ver clientes →

                </a>

            </div>

        </div>

    </div>


    <!-- PRODUCTOS -->
    <div class="col-md-6 col-xl">

        <div class="card dashboard-card h-100">

            <div class="card-body">

                <div class="dashboard-card-label">
                    Productos activos
                </div>

                <div class="dashboard-number">
                    @Model.ProductosActivos
                </div>

                <a asp-controller="Productos"
                   asp-action="Index"
                   class="dashboard-link">

                    Ver productos →

                </a>

            </div>

        </div>

    </div>


    <!-- FACTURAS ACTIVAS -->
    <div class="col-md-6 col-xl">

        <div class="card dashboard-card h-100">

            <div class="card-body">

                <div class="dashboard-card-label">
                    Facturas activas
                </div>

                <div class="dashboard-number">
                    @Model.FacturasActivas
                </div>

                <a asp-controller="Facturas"
                   asp-action="Index"
                   asp-route-filtroEstado="Activas"
                   class="dashboard-link">

                    Ver facturas →

                </a>

            </div>

        </div>

    </div>


    <!-- FACTURAS ANULADAS -->
    <div class="col-md-6 col-xl">

        <div class="card dashboard-card dashboard-card-danger h-100">

            <div class="card-body">

                <div class="dashboard-card-label">
                    Facturas anuladas
                </div>

                <div class="dashboard-number">
                    @Model.FacturasAnuladas
                </div>

                <a asp-controller="Facturas"
                   asp-action="Index"
                   asp-route-filtroEstado="Anuladas"
                   class="dashboard-link text-danger">

                    Ver anuladas →

                </a>

            </div>

        </div>

    </div>

</div>


<!-- TOTAL FACTURADO -->
<div class="card total-card mb-4">

    <div class="card-body">

        <div class="row align-items-center">

            <div class="col-md-7">

                <div class="dashboard-card-label mb-2">
                    Total facturado
                </div>

                <div class="total-number">
                    @Model.TotalFacturado.ToString("C2")
                </div>

                <p class="text-muted mb-0 mt-2">
                    Importe correspondiente únicamente
                    a facturas activas.
                </p>

            </div>

            <div class="col-md-5 text-md-end mt-3 mt-md-0">

                <a asp-controller="Facturas"
                   asp-action="Index"
                   asp-route-filtroEstado="Activas"
                   class="btn btn-outline-primary">

                    Consultar facturación

                </a>

            </div>

        </div>

    </div>

</div>


<!-- ACCIONES RÁPIDAS -->
<div class="card">

    <div class="card-body">

        <div class="mb-4">

            <h4 class="mb-1">
                Acciones rápidas
            </h4>

            <p class="text-muted mb-0">
                Accesos principales del sistema
            </p>

        </div>


        <div class="row g-3">

            <!-- CLIENTES -->
            <div class="col-md-4">

                <a asp-controller="Clientes"
                   asp-action="Index"
                   class="quick-action">

                    <span class="quick-action-symbol">
                        C
                    </span>

                    <span>
                        <strong>Clientes</strong>

                        <small>
                            Administrar clientes
                        </small>
                    </span>

                </a>

            </div>


            <!-- PRODUCTOS -->
            <div class="col-md-4">

                <a asp-controller="Productos"
                   asp-action="Index"
                   class="quick-action">

                    <span class="quick-action-symbol">
                        P
                    </span>

                    <span>
                        <strong>Productos</strong>

                        <small>
                            Administrar catálogo
                        </small>
                    </span>

                </a>

            </div>


            <!-- FACTURAS -->
            <div class="col-md-4">

                <a asp-controller="Facturas"
                   asp-action="Index"
                   class="quick-action">

                    <span class="quick-action-symbol">
                        F
                    </span>

                    <span>
                        <strong>Facturas</strong>

                        <small>
                            Consultar historial
                        </small>
                    </span>

                </a>

            </div>

        </div>

    </div>

</div>