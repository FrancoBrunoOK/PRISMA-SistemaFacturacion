@model SistemaFacturacion.Models.NuevaFacturaViewModel

@{
    ViewData["Title"] = "Resumen de factura";
}

<!-- ENCABEZADO -->
<div class="page-header mb-4">

    <div>
        <h1 class="mb-1">
            Nueva Factura
        </h1>

        <p class="text-muted mb-0">
            Revise la información antes de confirmar la factura
        </p>
    </div>

    <a asp-action="Index"
       class="btn btn-outline-secondary">
        Cancelar factura
    </a>

</div>


<!-- INDICADOR DE PASOS -->
<div class="invoice-steps mb-4">

    <div class="invoice-step">

        <div class="invoice-step-number">
            1
        </div>

        <div>
            <strong>Cliente</strong>
            <small>Seleccionar cliente</small>
        </div>

    </div>

    <div class="invoice-step-line"></div>

    <div class="invoice-step">

        <div class="invoice-step-number">
            2
        </div>

        <div>
            <strong>Productos</strong>
            <small>Agregar productos</small>
        </div>

    </div>

    <div class="invoice-step-line"></div>

    <div class="invoice-step active">

        <div class="invoice-step-number">
            3
        </div>

        <div>
            <strong>Resumen</strong>
            <small>Revisar factura</small>
        </div>

    </div>

    <div class="invoice-step-line"></div>

    <div class="invoice-step">

        <div class="invoice-step-number">
            4
        </div>

        <div>
            <strong>Factura</strong>
            <small>Comprobante final</small>
        </div>

    </div>

</div>


<!-- DATOS DEL CLIENTE -->
<div class="card mb-4">

    <div class="card-header py-3">
        <strong>
            Datos del cliente
        </strong>
    </div>

    <div class="card-body p-4">

        <div class="row g-4">

            <!-- NOMBRE -->
            <div class="col-md-6">

                <div class="detail-label">
                    Nombre
                </div>

                <div class="detail-value">
                    @ViewBag.Cliente.Nombre
                </div>

            </div>


            <!-- CUIT / DNI -->
            <div class="col-md-6">

                <div class="detail-label">
                    Identificación
                </div>

                <div class="detail-value">

                    @if (!string.IsNullOrWhiteSpace(ViewBag.Cliente.CUIT))
                    {
                        <span>
                            CUIT: @ViewBag.Cliente.CUIT
                        </span>
                    }
                    else if (!string.IsNullOrWhiteSpace(ViewBag.Cliente.DNI))
                    {
                        <span>
                            DNI: @ViewBag.Cliente.DNI
                        </span>
                    }
                    else
                    {
                        <span class="text-muted">
                            No informada
                        </span>
                    }

                </div>

            </div>


            <!-- DIRECCIÓN -->
            <div class="col-md-6">

                <div class="detail-label">
                    Dirección
                </div>

                <div class="detail-value">

                    @if (!string.IsNullOrWhiteSpace(ViewBag.Cliente.Direccion))
                    {
                        @ViewBag.Cliente.Direccion
                    }
                    else
                    {
                        <span class="text-muted">
                            No informada
                        </span>
                    }

                </div>

            </div>


            <!-- EMAIL -->
            <div class="col-md-6">

                <div class="detail-label">
                    Email
                </div>

                <div class="detail-value">

                    @if (!string.IsNullOrWhiteSpace(ViewBag.Cliente.Email))
                    {
                        @ViewBag.Cliente.Email
                    }
                    else
                    {
                        <span class="text-muted">
                            No informado
                        </span>
                    }

                </div>

            </div>

        </div>

    </div>

</div>


<!-- PRODUCTOS -->
<div class="card mb-4">

    <div class="card-header py-3">

        <div class="d-flex justify-content-between
                    align-items-center">

            <strong>
                Productos
            </strong>

            <span class="badge bg-primary">
                @Model.Detalles.Count
            </span>

        </div>

    </div>

    <div class="card-body p-0">

        <div class="table-responsive">

            <table class="table table-hover mb-0">

                <thead>

                    <tr>

                        <th class="ps-4">
                            Producto
                        </th>

                        <th class="text-center">
                            Cantidad
                        </th>

                        <th class="text-end">
                            Precio unitario
                        </th>

                        <th class="text-end">
                            IVA
                        </th>

                        <th class="text-end pe-4">
                            Subtotal
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var detalle in Model.Detalles)
                    {
                        <tr>

                            <td class="ps-4">

                                <strong>
                                    @detalle.Descripcion
                                </strong>

                            </td>

                            <td class="text-center">
                                @detalle.Cantidad
                            </td>

                            <td class="text-end">
                                @detalle.PrecioUnitario.ToString("C2")
                            </td>

                            <td class="text-end">
                                @detalle.IVA.ToString("N2") %
                            </td>

                            <td class="text-end pe-4">

                                <strong>
                                    @detalle.Subtotal.ToString("C2")
                                </strong>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


<!-- CONFIRMACIÓN -->
<form asp-action="Confirmar"
      method="post">

    @Html.AntiForgeryToken()


    <div class="row g-4 mb-4">

        <!-- MÉTODO DE PAGO -->
        <div class="col-lg-6">

            <div class="card h-100">

                <div class="card-header py-3">
                    <strong>
                        Método de pago
                    </strong>
                </div>

                <div class="card-body">

                    <label class="form-label">
                        Seleccione cómo se realizará el pago
                    </label>

                    <select name="metodoPago"
                            class="form-select"
                            required>

                        <option value="">
                            Seleccione un método de pago...
                        </option>

                        <option value="Efectivo">
                            Efectivo
                        </option>

                        <option value="Tarjeta de débito">
                            Tarjeta de débito
                        </option>

                        <option value="Tarjeta de crédito">
                            Tarjeta de crédito
                        </option>

                        <option value="Pago con QR">
                            Pago con QR
                        </option>

                    </select>

                    <small class="text-muted d-block mt-2">
                        El método seleccionado quedará registrado en la factura.
                    </small>

                </div>

            </div>

        </div>


        <!-- NOTA -->
        <div class="col-lg-6">

            <div class="card h-100">

                <div class="card-header py-3">
                    <strong>
                        Nota opcional
                    </strong>
                </div>

                <div class="card-body">

                    <label class="form-label">
                        Observaciones
                    </label>

                    <textarea name="Nota"
                              class="form-control"
                              rows="4"
                              placeholder="Escriba una nota u observación...">@Model.Nota</textarea>

                    <small class="text-muted d-block mt-2">
                        Este campo puede dejarse vacío.
                    </small>

                </div>

            </div>

        </div>

    </div>


    <!-- RESUMEN DEL PAGO -->
    <div class="card mb-4">

        <div class="card-header py-3">
            <strong>
                Resumen del pago
            </strong>
        </div>

        <div class="card-body p-4">

            <div class="row">

                <div class="col-lg-5 ms-auto">

                    <div class="payment-summary">

                        <!-- SUBTOTAL -->
                        <div class="payment-summary-row">

                            <span>
                                Subtotal
                            </span>

                            <strong>
                                @Model.Subtotal.ToString("C2")
                            </strong>

                        </div>


                        <!-- IVA -->
                        <div class="payment-summary-row">

                            <span>
                                IVA
                            </span>

                            <strong>
                                @Model.TotalIVA.ToString("C2")
                            </strong>

                        </div>


                        <!-- TOTAL -->
                        <div class="payment-summary-total">

                            <span>
                                Total
                            </span>

                            <strong>
                                @Model.Total.ToString("C2")
                            </strong>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ACCIONES -->
    <div class="form-actions">

        <a asp-action="Productos"
           asp-route-clienteId="@Model.ClienteId"
           class="btn btn-outline-secondary">
            ← Volver a Productos
        </a>

        <button type="submit"
                class="btn btn-success">
            Confirmar Factura
        </button>

    </div>

</form>